   "source": [
    "### Practice mean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4fb8905b-7ecc-4b7d-9372-84cc1049a217",
   "metadata": {},
   "outputs": [],
   "source": [
    "def my_mean(values):\n",
    "    total = 0\n",
    "    count = 0\n",
    "    for v in values:\n",
    "        total += v\n",
    "        count += 1\n",
    "    return total/count"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "b8cec8d4-1747-47c3-a480-5d4891ba4dae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "4.0\n"
     ]
    }
   ],
   "source": [
    "print (my_mean([2,4,6]))"
   ]
  },
